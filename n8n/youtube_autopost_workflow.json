        }
      },
      "id": "aa110000-0000-4000-8000-000000000002",
      "name": "Read Video",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [-20, 0]
    },
    {
      "parameters": {
