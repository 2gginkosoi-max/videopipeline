{
  "id": "YtShortsAutopst1",
  "name": "YouTube Shorts Autopost",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-short",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "aa110000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 0],
      "webhookId": "aa110000-1111-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Webhook').item.json.body.videoPath }}",
