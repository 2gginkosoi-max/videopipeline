        "options": {
          "description": "={{ $('Webhook').item.json.body.description }}",
          "privacyStatus": "={{ $('Webhook').item.json.body.privacyStatus || 'unlisted' }}",
          "tags": "={{ $('Webhook').item.json.body.tags }}",
          "notifySubscribers": false,
          "selfDeclaredMadeForKids": false
        }
      },
      "id": "aa110000-0000-4000-8000-000000000003",
      "name": "YouTube Upload",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [220, 0]
    }
