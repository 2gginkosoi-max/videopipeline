# Конфиг для деплоя
# Скопируй в .env и заполни при необходимости

# Порты
PORT=7860
HOST=0.0.0.0

# Пути (если не указаны - используются исторические D:\AI\... или корень репозитория)
# VIDEO_PIPELINE_DIR=/app
# F5TTS_DIR=/app/F5-TTS
# Интерпретатор для auto_news.py / F5-TTS (по умолчанию - текущий python)
# PIPELINE_PYTHON=/usr/bin/python3

# FFmpeg/yt-dlp
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# Скачивание с YouTube (bot-check)
# cookies из браузера: chrome | edge | firefox (по умолчанию пробуются все)
# YTDLP_COOKIES_FROM_BROWSER=chrome
# либо файл cookies в формате Netscape
# YTDLP_COOKIES=D:\cookies.txt
# отключить автоматические попытки браузерных cookies
# YTDLP_NO_BROWSER_COOKIES=1

# Лимиты для публичного доступа
MAX_CONCURRENT_JOBS=1
MAX_VIDEOS_PER_USER=10

# Pollinations (бесплатный LLM) - работает без ключа
POLLINATIONS_MODEL=openai-fast

# Субтитры для нарезки (faster-whisper)
# WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
# WHISPER_MODEL_DIR=D:\AI\whisper\small
# WHISPER_DEVICE=cuda          # cpu | cuda (по умолчанию авто)
# WHISPER_COMPUTE=float16      # int8 для CPU, float16 для GPU
# WHISPER_LANG=ru
# SUB_FONTS_DIR=D:onts       # если Montserrat не установлен в системе
# Нарезка: длина клипа/режим
# SLICE_MODE=reencode          # reencode (точно) | copy (быстро, по ключевым кадрам)
